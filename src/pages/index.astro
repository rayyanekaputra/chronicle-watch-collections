			</div>
		</div>

		<div class="footer">
			<div class="footer-navs">
				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">Home</p>
					<nav>
						<ul>
							<li><a href="#"><p>Main</p></a></li>
							<li><a href="#"><p>Latest</p></a></li>
							<li><a href="#"><p>Updates</p></a></li>
						</ul>
					</nav>
				</div>

				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">About</p>
					<nav>
						<ul>
							<li><a href="#"><p>Company</p></a></li>
							<li><a href="#"><p>Team</p></a></li>
							<li><a href="#"><p>Careers</p></a></li>
						</ul>
					</nav>
				</div>

				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">Services</p>
					<nav>
						<ul>
							<li><a href="#"><p>Design</p></a></li>
							<li><a href="#"><p>Development</p></a></li>
							<li><a href="#"><p>Consulting</p></a></li>
						</ul>
					</nav>
				</div>

				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">Support</p>
					<nav>
						<ul>
							<li><a href="#"><p>Help Center</p></a></li>
							<li><a href="#"><p>FAQ</p></a></li>
							<li><a href="#"><p>Contact</p></a></li>
						</ul>
					</nav>
				</div>

				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">Legal</p>
					<nav>
						<ul>
							<li><a href="#"><p>Privacy Policy</p></a></li>
							<li><a href="#"><p>Terms</p></a></li>
							<li><a href="#"><p>Cookies</p></a></li>
						</ul>
					</nav>
				</div>

				<div data-scroll class="footer-navs-wrapper">
					<p class="footer-navs-header">Social</p>
					<nav>
						<ul>
							<li><a href="#"><p>Facebook</p></a></li>
							<li><a href="#"><p>Twitter</p></a></li>
							<li><a href="#"><p>Instagram</p></a></li>
						</ul>
					</nav>
				</div>
			</div>

			<div class="footer-copyright">
				<div class="footer-copyright-items">
					<p>COPYRIGHT</p>
				</div>
				<div class="footer-copyright-items">
					<p>CREDIT</p>
				</div>
				<div class="footer-copyright-items">
					<p>SOCIAL MEDIA</p>
				</div>
			</div>

			<h1 id="FOOTER-LOGO" data-scroll data-scroll-speed="0.3">CHRONICLE</h1>
		</div>
	</body>
</html>

<script>
	//@ts-nocheck
	//SCRIPT ALWAYS RENDERED CLIENT
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import LocomotiveScroll from "locomotive-scroll";
	const scroll = new LocomotiveScroll({
		lenisOptions: {
			lerp: 0.5,
			duration: 2,
		},
	});

	gsap.registerPlugin(ScrollTrigger);
	const boxes = gsap.utils.toArray(".box");
	const boxesWrapper = document.querySelector(".horizontal-section-wrapper");
	console.log(boxes);
	gsap.to(boxes, {
		ease: "none",
		xPercent: -100 * (boxes.length - 1),

		scrollTrigger: {
			trigger: boxesWrapper,
			markers: true,
			pin: true,
			scrub: 1,
			end: () => "+=" + (boxesWrapper.offsetWidth + 80), //+80 karena ada margin-bottom,
		},
	});
</script>
